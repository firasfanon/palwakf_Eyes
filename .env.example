# Documentation only. Do not commit real credentials.
# Runtime uses --dart-define rather than reading this file.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Map tile policy.
# local/staging: osm_standard is permitted for controlled, low-volume use.
# production: only approved_external + MAP_TILE_PROVIDER_APPROVED=true.
PAL_EYES_ENV=local
MAP_TILE_PROVIDER_MODE=osm_standard
MAP_TILE_URL_TEMPLATE=
MAP_TILE_ATTRIBUTION_TEXT=
MAP_TILE_ATTRIBUTION_URL=
MAP_TILE_ISSUE_REPORT_URL=
MAP_TILE_USER_AGENT_PACKAGE_NAME=ps.paleyes.app
MAP_TILE_MAX_NATIVE_ZOOM=19
MAP_TILE_PROVIDER_APPROVED=false

# Forbidden by project policy:
# - tile prefetch
# - bulk tile download
# - offline tile archive
# - background map seeding
